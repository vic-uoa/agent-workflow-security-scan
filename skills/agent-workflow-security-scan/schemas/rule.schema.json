{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-workflow-security-rule:1.0.0",
  "type": "object",
  "required": ["id", "title", "severity", "detectability", "standards", "applicability", "confidence_policy", "evidence_policy"],
  "properties": {
    "id": {"type": "string", "pattern": "^(FLOW|IN|LLM|TOOL|OUT|KB)-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 2},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
    "detectability": {"enum": ["S", "H", "M", "D"]},
    "standards": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "applicability": {"type": "string"},
    "confidence_policy": {"type": "string"},
    "evidence_policy": {"type": "string"},
    "remediation_family": {"type": "string"},
    "dynamic_test_template": {"type": ["string", "null"]}
    ,"references": {"type": "array", "items": {"type": "string"}}
    ,"provenance": {"type": "string"}
    ,"attack_family": {"type": "string"}
    ,"root_cause_family": {"type": "string"}
    ,"requires_dynamic_validation": {"type": "boolean"}
    ,"applies_to": {"type": "array", "items": {"type": "string"}}
    ,"exclusion_facts": {"type": "array", "items": {"type": "string"}}
    ,"required_facts": {"type": "array", "items": {"type": "string"}}
    ,"candidate_facts": {"type": "array", "items": {"type": "string"}}
    ,"unknown_policy": {"type": "string"}
    ,"gate_policy": {"type": "string"}
  },
  "additionalProperties": true
}
